{
  "database": "Zotero",
  "noteImportFolder": "02_Sources/Papers",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "Bibtex",
      "format": "biblatex",
      "command": "autocite"
    }
  ],
  "exportFormats": [
    {
      "name": "Import #1",
      "outputPathTemplate": "02_Sources/Papers/{{citekey}}.md",
      "imageOutputPathTemplate": "02_Sources/Zotero_Attachments/{{citekey}}/",
      "templatePath": "Templates/TPL — Paper Note.md",
      "imageBaseNameTemplate": "image"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": false,
  "whichNotesToOpenAfterImport": "first-imported-note"
}
